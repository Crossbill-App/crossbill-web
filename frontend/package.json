{
  "name": "crossbill-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run routes:generate && vite",
    "build": "npm run routes:generate && npm run api:generate && tsc && vite build",
    "build:ci": "npm run routes:generate && tsc && vite build",
    "preview": "vite preview",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "api:generate": "orval && npm run format",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "type-check": "npm run routes:generate && tsc --noEmit",
    "test": "npm run routes:generate && vitest run",
    "test:watch": "npm run routes:generate && vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.143.4",
    "axios": "^1.13.5",
    "dompurify": "^3.3.2",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "motion": "^12.23.26",
    "react": "^19.2.3",
    "react-blurhash": "^0.3.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router-devtools": "^1.143.4",
    "@tanstack/router-cli": "^1.143.4",
    "@types/dompurify": "^3.2.0",
    "@types/lodash": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.7",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "msw": "^2.15.0",
    "orval": "8.23.0",
    "playwright": "^1.62.1",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}

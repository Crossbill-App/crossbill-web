{
  "name": "crossbill-frontend",
  "private": true,
  "version": "0.28.1",
  "type": "module",
  "scripts": {
    "dev": "npm run routes:generate && vite",
    "build": "npm run routes:generate && npm run api:generate && tsc && vite build",
    "build:ci": "npm run routes:generate && tsc && vite build",
    "preview": "vite preview",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "api:generate": "orval && npm run format",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "type-check": "npm run routes:generate && tsc --noEmit",
    "test": "npm run routes:generate && vitest run",
    "test:watch": "npm run routes:generate && vitest",
    "knip": "npm run routes:generate && knip",
    "duplication-check": "jscpd --no-tips"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.12.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.32",
    "axios": "^1.19.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "motion": "^13.1.1",
    "react": "^19.2.3",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/router-cli": "^1.167.21",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.0.0",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "msw": "^2.15.0",
    "orval": "8.23.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}

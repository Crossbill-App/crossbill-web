{
  "name": "crossbill-frontend",
  "private": true,
  "version": "0.33.0",
  "type": "module",
  "scripts": {
    "dev": "npm run routes:generate && vite",
    "build": "npm run routes:generate && npm run api:generate && tsc && vite build",
    "build:ci": "npm run routes:generate && tsc && vite build",
    "preview": "vite preview",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "api:generate": "orval && npm run format",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "type-check": "npm run routes:generate && tsc --noEmit",
    "test": "npm run routes:generate && vitest run",
    "test:watch": "npm run routes:generate && vitest",
    "test:unit": "vitest run --project unit",
    "knip": "npm run routes:generate && knip",
    "duplication-check": "jscpd --no-tips"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.12.0",
    "@readium/navigator": "2.10.3",
    "@readium/shared": "2.5.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.41",
    "axios": "^1.20.0",
    "i18next": "^26.4.2",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-activity-calendar": "^3.2.1",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/router-cli": "^1.167.40",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jscpd": "^5.3.2",
    "knip": "^6.31.0",
    "msw": "^2.15.0",
    "orval": "8.28.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.3.0"
  }
}

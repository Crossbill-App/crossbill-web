# Database
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://crossbill:crossbill_dev_password@localhost:5432/crossbill

# SQLite (for local development without Docker)
# DATABASE_URL=sqlite:///./crossbill.db

# JWT signing secrets — REQUIRED. The backend refuses to start if either is
# empty or shorter than 32 bytes. Generate strong random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (or `openssl rand -hex 32`). Use different values for access and refresh.
SECRET_KEY=
REFRESH_TOKEN_SECRET_KEY=

# PostgreSQL password for docker-compose (production)
# CHANGE THIS IN PRODUCTION!
POSTGRES_PASSWORD=crossbill_secure_password

# Environment
ENVIRONMENT=development

# Port (for docker-compose)
PORT=8000

# CORS - Allow requests from these origins.
# Defaults to localhost dev ports (3000, 5173, 8000) when unset.
# In production, CORS_ORIGINS MUST be set to explicit origins — wildcard "*"
# and empty lists are rejected at startup.
#CORS_ORIGINS='["https://mydomain.example.com"]'

# Which entry of X-Forwarded-For the per-IP rate limiter keys on. Getting this
# wrong either lets callers forge their own bucket or lumps every request behind
# the proxy into one, so it depends on what your proxy does with the header.
#
# Proxies that APPEND to it (nginx, HAProxy, Caddy) keep whatever the caller
# sent and add their peer on the right, so only the rightmost entries are real:
#   0 = the app is directly exposed (default). X-Forwarded-For is ignored.
#   1 = exactly one appending proxy in front.
#   2 = two chained appending proxies.
TRUSTED_PROXY_HOPS=0

# Proxies that REWRITE it discard what the caller sent and start a fresh chain,
# so no hop count can find the client. Railway does this: a request through
# Cloudflare arrives as
#   x-forwarded-for: <cloudflare-egress>, <railway-pop>
# with the browser's address absent entirely. Railway puts it in x-real-ip
# instead (substituting cf-connecting-ip when the request came from trusted
# Cloudflare infrastructure), so the fix is to believe x-real-ip — but only when
# the request genuinely came through the proxy that sets it.
#
# TRUSTED_PROXY_CIDRS is matched against the TCP peer address, which no caller
# can forge. A match means the proxy wrote the headers, so its x-real-ip is
# authoritative; no match means every header is caller-supplied and is ignored.
# On Railway the peer is its internal proxy, so set:

#   TRUSTED_PROXY_CIDRS='["100.64.0.0/10"]'
# and leave TRUSTED_PROXY_HOPS at 0. Behind your own nginx, use the address the
# proxy connects from (e.g. '["127.0.0.1/32"]'). Empty (default) disables it.
# TRUSTED_PROXY_CIDRS='[]'

# Log the peer address and every header of each request, so the two settings
# above can be matched to what your proxy actually sends rather than what it
# documents. Turn it on, make one request, and find the "proxy_chain" log line:
# "peer" is what TRUSTED_PROXY_CIDRS must contain, "peer_trusted" says whether
# it does, and "resolved" is the key the rate limiter would use. Credentials are
# excluded, but this logs everything else — turn it off once confirmed.
LOG_PROXY_CHAIN=false

# Admin setup (first-run bootstrap)
#
# ADMIN_PASSWORD is REQUIRED — the backend refuses to start if it is empty
# or set to the insecure literal "admin". It is only consumed on the very
# first startup to provision the initial admin user; after that the value
# is ignored and you manage the password from the UI.
#
# To set it:
#   1. Generate a strong password, e.g.
#        openssl rand -base64 24
#   2. Paste it below (or export ADMIN_PASSWORD in your shell / secrets
#      manager / docker-compose env).
#   3. Start the backend once so the admin user is created, then sign in
#      and change the password from the UI. You can safely clear or rotate
#      this variable afterwards.
#
# ADMIN_USERNAME is the login name for that initial user and defaults to
# "admin" — change it here if you prefer a different username.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=true

# Refreshing rotates the refresh token: the presented one is spent before its
# replacement can reach the client. If that response is lost — a dropped mobile
# connection, an app suspended mid-request — the client still holds a token the
# server considers used, and reading that as a stolen-token replay would end the
# session. For this many seconds after a rotation the spent token is answered
# with its replacement instead. Past the window reuse still revokes the whole
# session, so this trades a short replay window for sessions that survive a bad
# network. 0 disables it and restores strict single-use rotation.
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=60

# Password pepper - Secret value added to all passwords before hashing
# Generate with: openssl rand -hex 32
# IMPORTANT: Decide this before the first account exists. Changing the value, or
# introducing one on an install that already has users, makes every existing
# password stop working; recovery is a password reset per account.
# NOTE: Can be left empty or undefined if password peppering is not desired
PASSWORD_PEPPER=your_secret_pepper_here

# Allow anyone reaching the app to create an account. Defaults to false.
# Leave it false for a personal install exposed to the internet; the initial
# admin user is provisioned from ADMIN_USERNAME/ADMIN_PASSWORD above.
# Check the live value any time — it is reported at GET /api/v1/settings as
# "user_registrations".
ALLOW_USER_REGISTRATIONS=false

# AI model configurations. Optional. Only one service at time supported.

# AI_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# AI_MODEL_NAME=mistral-nemo:latest

# AI_PROVIDER=openai
# OPENAI_API_KEY=<apikey here>
# AI_MODEL_NAME=gpt-5-nano

# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<apikey here>
# AI_MODEL_NAME=claude-haiku-4-5-20251001

# AI_PROVIDER=google
# GEMINI_API_KEY=<apikey here>
# AI_MODEL_NAME=gemini-3-flash-preview

# AI_PROVIDER=openrouter
# AI_MODEL_NAME=minimax/minimax-m2.5   # or any OpenRouter model slug
# OPENROUTER_API_KEY=<apikey here>

# Background worker
# By default the app runs the SAQ worker in-process (embedded mode).
# Set EMBEDDED_WORKER=false to disable it and run a separate worker container instead.
# EMBEDDED_WORKER=true
# WORKER_CONCURRENCY=2

# S3-compatible storage (optional)
# When configured, files are stored in S3 instead of local disk.
# This is required for multi-container deployments (e.g., Railway)
# where app and worker containers cannot share a filesystem.
#
# For local development with Garage (run `docker compose up garage`):
# S3_ENDPOINT_URL=http://localhost:3900
# For Garage deployment with Garage from docker container to container
# S3_ENDPOINT_URL=http://garage:3900
# S3_ACCESS_KEY_ID=GKtest01
# S3_SECRET_ACCESS_KEY=testsecretkey0123456789
# S3_BUCKET_NAME=crossbill-files
# S3_REGION=garage
#
# For Railway or AWS S3:
# S3_ENDPOINT_URL=https://your-s3-endpoint.example.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=crossbill-files
# S3_REGION=us-east-1
